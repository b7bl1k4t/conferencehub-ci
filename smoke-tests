#!/bin/sh
set -eu
: "${DEPLOY_ROOT:?Set DEPLOY_ROOT}"
target=${1:-}
case "$target" in
    staging|prod) ;;
    *) printf 'Usage: sh smoke-tests staging|prod\n' >&2; exit 2 ;;
esac
sh test.sh
test -s "$DEPLOY_ROOT/$target/release.txt"
cmp dist/conferencehub-release.txt "$DEPLOY_ROOT/$target/release.txt"
printf 'SMOKE OK: %s contains the current artifact\n' "$target"
